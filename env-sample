# DPORT Means variable applied to Docker Port and SPORT variable applied to Service Application Port
# Pattern = {DPORT | SAPORT}_{Docker Service Name}_{HOST | CONTAINER}_{HTTP | HTTPS}
DPORT_NGINX_HOST_HTTP=80
DPORT_NGINX_HOST_HTTPS=443
DPORT_NGINX_CONTAINER_HTTP=80
DPORT_NGINX_CONTAINER_HTTPS=443
DPORT_BACKEND_HOST=8000
DPORT_BACKEND_CONTAINER=8000
DPORT_DB_HOST=5432
DPORT_DB_CONTAINER=5432
POSTGRES_DB={db name}
POSTGRES_USER={db user name}
POSTGRES_PASSWORD={db password}
POSTGRES_HOST={host example localhost can also refer to service name in docker-compose}
POSTGRES_PORT=5432

JWT_SECRET_KEY={use "openssl rand -hex 32" to generate}
JWT_ALGORITHM=HS256

BACKEND_CORS_ORIGINS=http://localhost
DOMAIN=melonamoy
PIPELINE=local

# Authentication
# OAUTH_* configures Google. Keep the existing SSO/Cognito values in SSO_OAUTH_*.
AUTH_PROVIDER=google
OAUTH_CLIENT_ID=xxx
OAUTH_CLIENT_SECRET=xxx
OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
OAUTH_REDIRECT_URI=https://localhost/api/v1/auth/callback
OAUTH_SCOPE=openid email profile
OAUTH_EXTRA_SCOPE=
FRONTEND_URL=https://localhost
SESSION_SECRET={use "openssl rand -hex 32" to generate}
APP_ENV=development

# SSO/Cognito values. Set these if OAUTH_* contains the Google configuration.
SSO_OAUTH_CLIENT_ID=
SSO_OAUTH_CLIENT_SECRET=
SSO_OAUTH_AUTHORIZE_URL=
SSO_OAUTH_TOKEN_URL=
SSO_OAUTH_USERINFO_URL=
